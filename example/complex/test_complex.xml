<?xml version="1.0" encoding="UTF-8"?>
<root>
    <column space="0" padding="16" background-color="#1e1e2e" background-radius="12">
        <!-- 标题行 -->
        <row space="12" cross-align="center" margin-bottom="4">
            <text font-size="22" bold="true" color="#cdd6f4" :content="device_name">服务器 #01</text>
            <text font-size="11" color="#a6e3a1" :content="status_text"
                  padding-left="8" padding-right="8" padding-top="4" padding-bottom="4"
                  background-color="#313244" background-radius="6">运行中</text>
        </row>

        <!-- 分隔线 -->
        <row space="0" margin-top="1" margin-bottom="12" background-color="#313244" background-radius="1">
            <text padding-top="1"> </text>
        </row>

        <!-- 核心指标网格 -->
        <grid columns="3" rows="2" space="12" margin-bottom="12">
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">CPU</text>
                    <text font-size="20" bold="true" color="#f38ba8" :content="cpu">45%</text>
                </column>
            </cell>
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">内存</text>
                    <text font-size="20" bold="true" color="#fab387" :content="memory">62%</text>
                </column>
            </cell>
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">磁盘</text>
                    <text font-size="20" bold="true" color="#89b4fa" :content="disk">78%</text>
                </column>
            </cell>
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">网络↓</text>
                    <text font-size="14" bold="true" color="#94e2d5" :content="net_in">12.5 MB/s</text>
                </column>
            </cell>
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">网络↑</text>
                    <text font-size="14" bold="true" color="#94e2d5" :content="net_out">3.2 MB/s</text>
                </column>
            </cell>
            <cell v-align="center" h-align="center" padding="10" background-color="#313244" background-radius="8">
                <column space="4" cross-align="center">
                    <text font-size="10" color="#6c7086">温度</text>
                    <text font-size="20" bold="true" color="#f9e2af" :content="temp">58°C</text>
                </column>
            </cell>
        </grid>

        <!-- 网络信息列表 -->
        <column space="8" margin-bottom="12">
            <text font-size="13" bold="true" color="#cdd6f4" margin-bottom="4">网络配置</text>
            <row space="8">
                <text font-size="11" color="#6c7086" width="42">IPv4</text>
                <text font-size="11" color="#bac2de" :content="ipv4">192.168.1.100</text>
            </row>
            <row space="8">
                <text font-size="11" color="#6c7086" width="42">MAC</text>
                <text font-size="11" color="#bac2de" :content="mac">AA:BB:CC:DD:EE:FF</text>
            </row>
            <row space="8">
                <text font-size="11" color="#6c7086" width="42">网关</text>
                <text font-size="11" color="#bac2de" :content="gateway">192.168.1.1</text>
            </row>
            <row space="8">
                <text font-size="11" color="#6c7086" width="42">DNS</text>
                <text font-size="11" color="#bac2de" :content="dns">8.8.8.8</text>
            </row>
        </column>

        <!-- 警告信息（条件显示） -->
        <if-has :prop="warning">
            <row space="8" cross-align="center" background-color="#f38ba8" background-radius="8"
                  margin-bottom="12"
                  padding-top="10" padding-bottom="10" padding-left="12" padding-right="12">
                <text font-size="14" bold="true" color="#1e1e2e">⚠</text>
                <text font-size="12" color="#1e1e2e" :content="warning">警告信息</text>
            </row>
        </if-has>

        <!-- 进程列表（循环） -->
        <column space="8">
            <text font-size="13" bold="true" color="#cdd6f4" margin-bottom="4">活跃进程</text>
            <for :of="processes" step="3">
                <row space="8" cross-align="center" padding="8" background-color="#313244" background-radius="6">
                    <text font-size="11" color="#cdd6f4">{}</text>
                    <text font-size="10" color="#6c7086">{}</text>
                    <text font-size="11" color="#a6e3a1" h-align="right" padding-left="8">{}</text>
                </row>
            </for>
        </column>
    </column>
</root>
