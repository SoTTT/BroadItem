<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:b="urn:broaditem:binding">
    <column space="0" padding="16" background-color="#1e1e2e" background-radius="12">
        <!-- 标题行：节点名 + 状态胶囊 -->
        <row space="12" cross-align="center" margin-bottom="4">
            <text font-size="18" bold="true" color="#cdd6f4" b:content="title">节点</text>
            <text font-size="11" color="#a6e3a1" b:content="status"
                  padding-left="8" padding-right="8" padding-top="4" padding-bottom="4"
                  background-color="#313244" background-radius="6">在线</text>
        </row>

        <!-- 分隔线 -->
        <rect height="1" background-color="#313244" background-radius="1" margin-top="1" margin-bottom="12"/>

        <!-- 核心指标：CPU / 内存 -->
        <row space="12">
            <column space="4" cross-align="center" padding="10" background-color="#313244" background-radius="8">
                <text font-size="10" color="#6c7086">CPU</text>
                <text font-size="18" bold="true" color="#f38ba8" b:content="cpu">45%</text>
            </column>
            <column space="4" cross-align="center" padding="10" background-color="#313244" background-radius="8">
                <text font-size="10" color="#6c7086">内存</text>
                <text font-size="18" bold="true" color="#fab387" b:content="memory">62%</text>
            </column>
        </row>
    </column>
</root>
