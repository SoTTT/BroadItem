<?xml version="1.0" encoding="UTF-8"?>
<root xmlns:b="urn:broaditem:binding">
    <column space="6" padding="10" background-color="#ffffff" background-radius="6">
        <text font-size="14" bold="true" color="#222" b:content="title">控制元素</text>
        <for b:of="items" b:as="it">
            <text font-size="12" color="#333" b:content="it"/>
        </for>
        <if b:prop="extra">
            <text font-size="12" color="#c0392b" b:content="extra"/>
        </if>
        <for b:of="users" b:as="u">
            <row space="6">
                <text font-size="11" color="#555" b:content="u.name"/>
                <text font-size="11" color="#999" b:content="u.email"/>
            </row>
        </for>
        <for b:of="groups" b:as="g">
            <column space="2" padding-left="8">
                <text font-size="12" bold="true" color="#2c3e50" b:content="g.name"/>
                <for b:of="g.members" b:as="m">
                    <text font-size="11" color="#777" padding-left="8" b:content="m"/>
                </for>
            </column>
        </for>
    </column>
</root>
