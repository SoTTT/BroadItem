<?xml version="1.0" encoding="UTF-8"?>
<!--
  BroadItem XML Layout Schema
  ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
  Provides autocomplete and validation for BroadItem layout XMLs.

  USAGE / VS Code:
    Install "XML" extension (redhat.vscode-xml), then add to settings.json:
      "xml.fileAssociations": [
        { "pattern": "**/*layout*.xml", "systemId": "broaditem.xsd" }
      ]

  USAGE (JetBrains / IntelliJ):
    Add to root element:
      <root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="broaditem.xsd">

  NAMESPACE:
    Binding attributes use the b: namespace prefix declared as
      xmlns:b="urn:broaditem:binding"

    Reserved (control / text-content channels): b:content / b:of / b:as / b:prop

    Generic property bindings: ANY literal attribute may be written as
    b:<attr> (reference semantics, resolved from PropertyContext at
    materialization time into the ResolvedStyle snapshot). First batch:
      box model (17): margin, margin-left/right/top/bottom,
        padding, padding-left/right/top/bottom,
        border-radius, border-style, border-width, border-color,
        background-color, background-radius, background-opacity
      size:         width, height
      text style:   color, font-size, bold, underline, font-family
      image:        src, keep-aspect
    A literal attribute and its b: form are mutually exclusive
    (qCritical, binding ignored). Layout attributes (space/align/
    columns/rows) and text v-align/h-align/wrap/max-width will open
    for binding in later batches.

    The parser auto-wraps any non-control element with b:of/b:as into <for>,
    and any with b:prop into <if>.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:b="urn:broaditem:binding"
           elementFormDefault="qualified">

  <!-- ================================================================ -->
  <!--  Common simple types                                             -->
  <!-- ================================================================ -->
  <xs:simpleType name="colorType">
    <xs:restriction base="xs:string">
      <xs:pattern value="#[0-9a-fA-F]{3,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="vAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="top"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="bottom"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="hAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="left"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="right"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="mainAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="space-between"/>
      <xs:enumeration value="space-around"/>
      <xs:enumeration value="space-evenly"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="crossAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- row 专用交叉轴对齐：在 crossAlignType 基础上增加 baseline（基线对齐）。
       baseline 仅 row 有效（交叉轴为垂直方向）；column 交叉轴为水平方向，
       无 baseline 语义，继续使用 crossAlignType。 -->
  <xs:simpleType name="rowCrossAlignType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="stretch"/>
      <xs:enumeration value="baseline"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="borderStyleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="solid"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="boolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="mainStretchBoolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>
      <xs:enumeration value="false"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="nonNegativeDouble">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="opacityType">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="positiveInt">
    <xs:restriction base="xs:positiveInteger"/>
  </xs:simpleType>

  <!-- ================================================================ -->
  <!--  Box model attribute group (shared by all renderable elements)   -->
  <!-- ================================================================ -->
  <xs:attributeGroup name="boxModelAttrs">
    <xs:attribute name="margin"            type="nonNegativeDouble"/>
    <xs:attribute name="margin-left"       type="nonNegativeDouble"/>
    <xs:attribute name="margin-right"      type="nonNegativeDouble"/>
    <xs:attribute name="margin-top"        type="nonNegativeDouble"/>
    <xs:attribute name="margin-bottom"     type="nonNegativeDouble"/>
    <xs:attribute name="padding"           type="nonNegativeDouble"/>
    <xs:attribute name="padding-left"      type="nonNegativeDouble"/>
    <xs:attribute name="padding-right"     type="nonNegativeDouble"/>
    <xs:attribute name="padding-top"       type="nonNegativeDouble"/>
    <xs:attribute name="padding-bottom"    type="nonNegativeDouble"/>
    <xs:attribute name="border-radius"     type="nonNegativeDouble"/>
    <xs:attribute name="border-style"      type="borderStyleType"/>
    <xs:attribute name="border-width"      type="nonNegativeDouble"/>
    <xs:attribute name="border-color"      type="colorType"/>
    <xs:attribute name="background-color"  type="colorType"/>
    <xs:attribute name="background-radius" type="nonNegativeDouble"/>
    <xs:attribute name="background-opacity" type="opacityType"/>
  </xs:attributeGroup>

  <!-- ================================================================ -->
  <!--  Data binding attributes (b: namespace)                           -->
  <!--  Defined via anyAttribute in the binding namespace; editors can    -->
  <!--  autocomplete via the annotation/documentation below.              -->
  <!-- ================================================================ -->
  <xs:attributeGroup name="bindingAttrs">
    <xs:anyAttribute namespace="urn:broaditem:binding" processContents="lax">
      <xs:annotation>
        <xs:documentation>
Binding attributes (b: prefix, xmlns:b="urn:broaditem:binding"):

Reserved (control / text-content channels):
  b:content = property path for TextElement content binding
  b:of      = property path for ForElement data source
  b:as      = per-item variable name for ForElement
  b:prop    = property path for IfElement condition check

Generic property bindings (reference semantics):
  Any literal attribute may be written as b:&lt;attr&gt;; the value is a
  property path resolved from PropertyContext at materialization time
  and stored in the instance node's ResolvedStyle snapshot.
  First batch supported:
    box model : b:margin, b:margin-left/right/top/bottom,
                b:padding, b:padding-left/right/top/bottom,
                b:border-radius, b:border-style, b:border-width,
                b:border-color,
                b:background-color, b:background-radius,
                b:background-opacity
    size      : b:width, b:height
    text style: b:color, b:font-size, b:bold, b:underline,
                b:font-family

  A literal attribute and its b: form are mutually exclusive:
  if both appear, the parser logs qCritical and ignores the binding
  (the literal wins). Missing path falls back to the attribute
  default silently; type mismatch logs qCritical and falls back.
  Layout attributes (space/align/columns/rows) and text
  v-align/h-align/wrap/max-width will open in later batches.

These are W3C-compliant namespace-qualified attributes.
The b: prefix is the canonical prefix, but any prefix bound to
urn:broaditem:binding is accepted by the parser.
        </xs:documentation>
      </xs:annotation>
    </xs:anyAttribute>
  </xs:attributeGroup>

  <!-- ================================================================ -->
  <!--  Combined: typed box model + loose binding attrs                  -->
  <!-- ================================================================ -->
  <xs:attributeGroup name="renderableAttrs">
    <xs:attributeGroup ref="boxModelAttrs"/>
    <xs:attributeGroup ref="bindingAttrs"/>
  </xs:attributeGroup>

  <!-- ================================================================ -->
  <!--  Group: any layout child (column/row/for/if/cell child)          -->
  <!-- ================================================================ -->
  <xs:group name="layoutChildren">
    <xs:choice>
      <xs:element ref="text"/>
      <xs:element ref="image"/>
      <xs:element ref="column"/>
      <xs:element ref="row"/>
      <xs:element ref="grid"/>
      <xs:element ref="for"/>
      <xs:element ref="if"/>
    </xs:choice>
  </xs:group>

  <!-- ================================================================ -->
  <!--  <root> — top-level; exactly one child                           -->
  <!-- ================================================================ -->
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:choice>
          <xs:element ref="column"/>
          <xs:element ref="row"/>
          <xs:element ref="grid"/>
          <xs:element ref="text"/>
          <xs:element ref="image"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <text>                                                          -->
  <!--  Mixed content: text between tags = default display text          -->
  <!--  content / b:content are MUTUALLY EXCLUSIVE                      -->
  <!-- ================================================================ -->
  <xs:element name="text">
    <xs:annotation>
      <xs:documentation>
text — renders text with optional data binding.

Static:  content="Hello"  OR  text between tags
Binding: b:content="propName"  (e.g. "device.cpu")
         content and b:content are mutually exclusive.

Size:    width / height (pixels, optional; omit = auto)

Font:    font-family (string), font-size (px, default 12)
         bold, underline (true/false)

Layout:  v-align (top|center|bottom), h-align (left|center|right)

Color:   color (e.g. #333, #f0f0f0ff)

Wrap:    wrap (true/false), max-width (px — triggers word wrap)
      </xs:documentation>
    </xs:annotation>
    <xs:complexType mixed="true">
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="content"         type="xs:string"/>
      <xs:attribute name="v-align"         type="vAlignType"      default="top"/>
      <xs:attribute name="h-align"         type="hAlignType"      default="left"/>
      <xs:attribute name="font-family"     type="xs:string"/>
      <xs:attribute name="font-size"       type="nonNegativeDouble" default="12"/>
      <xs:attribute name="bold"            type="boolType"/>
      <xs:attribute name="underline"      type="boolType"/>
      <xs:attribute name="wrap"            type="boolType"/>
      <xs:attribute name="max-width"       type="nonNegativeDouble"/>
      <xs:attribute name="color"           type="colorType"/>
      <xs:attribute name="width"           type="nonNegativeDouble"/>
      <xs:attribute name="height"          type="nonNegativeDouble"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <image> — self-sized image element                              -->
  <!--  src / b:src are MUTUALLY EXCLUSIVE (qCritical, binding ignored) -->
  <!-- ================================================================ -->
  <xs:element name="image">
    <xs:annotation>
      <xs:documentation>
image — renders a local image loaded via QPixmap at materialization time.

Static:  src=":/icons/red.png"  (Qt resource path, ":/" prefix)
         src="/abs/file.png" or "rel/file.png" (relative to process CWD)
         URLs are NOT supported (QPixmap load failure semantics apply).
Binding: b:src="iconPath"  (reference semantics, mutually exclusive with src)

Size:    width / height (pixels, optional; omit = auto)
         explicit size wins; single dimension derives the other from the
         image aspect ratio; no explicit size uses the pixmap's natural size.

keep-aspect: true (default) = contain, centered on both axes;
             false = stretch to fill the content rect. Never crops.

Failure semantics: failed load logs one qWarning (with path), renders a
blank 0x0 content area; box model decorators still paint. Empty src and
unresolved bindings stay silent. Successful and failed loads are cached
at template level (never evicted, GUI single-thread assumption).

Formats follow QPixmap: PNG/JPEG built-in; SVG via Qt imageformats plugin.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="src"         type="xs:string"/>
      <xs:attribute name="keep-aspect" type="boolType" default="true"/>
      <xs:attribute name="width"       type="nonNegativeDouble"/>
      <xs:attribute name="height"      type="nonNegativeDouble"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <column> — vertical stack                                       -->
  <!-- ================================================================ -->
  <xs:element name="column">
    <xs:annotation>
      <xs:documentation>
column — stacks children vertically.

main-align:  start | center | end   (default: start)
cross-align: start | center | end | stretch  (default: stretch)
             ("baseline" is valid on row only; column has no baseline semantics)
space:       gap between children in pixels (default: 0)
main-stretch: true | false  (default: false) — stretch all children to max main-axis size

Box model attributes (margin, padding, border, background) apply.
Control pseudo-attributes (b:of, b:as, b:prop) auto-wrap if present.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="layoutChildren" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="main-align"   type="mainAlignType"  default="start"/>
      <xs:attribute name="cross-align"  type="crossAlignType" default="stretch"/>
      <xs:attribute name="space"        type="nonNegativeDouble" default="0"/>
      <xs:attribute name="main-stretch" type="mainStretchBoolType" default="false"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <row> — horizontal stack                                        -->
  <!-- ================================================================ -->
  <xs:element name="row">
    <xs:annotation>
      <xs:documentation>
row — stacks children horizontally. Attributes identical to column,
except cross-align additionally accepts "baseline" (baseline alignment;
children without a baseline fall back to bottom-edge alignment).
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="layoutChildren" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="main-align"   type="mainAlignType"  default="start"/>
      <xs:attribute name="cross-align"  type="rowCrossAlignType" default="stretch"/>
      <xs:attribute name="space"        type="nonNegativeDouble" default="0"/>
      <xs:attribute name="main-stretch" type="mainStretchBoolType" default="false"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <cell> — grid cell (only valid child of grid)                   -->
  <!-- ================================================================ -->
  <xs:element name="cell">
    <xs:annotation>
      <xs:documentation>
cell — grid cell. Must be inside grid.
Contains exactly one child layout element.

v-align: top | center | bottom  (default: top)
h-align: left | center | right  (default: left)
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="layoutChildren" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="v-align" type="vAlignType" default="top"/>
      <xs:attribute name="h-align" type="hAlignType" default="left"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <grid> — fixed grid layout                                      -->
  <!-- ================================================================ -->
  <xs:element name="grid">
    <xs:annotation>
      <xs:documentation>
grid — fixed rows × columns grid. Children MUST be cell elements.
Child count MUST equal columns × rows.

columns:      number of columns (required, positive integer)
rows:         number of rows (required, positive integer)
space:        default cell spacing in pixels (default: 0)
space-row:    override vertical spacing
space-column: override horizontal spacing
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="cell" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="renderableAttrs"/>
      <xs:attribute name="columns"       type="positiveInt"/>
      <xs:attribute name="rows"          type="positiveInt"/>
      <xs:attribute name="space"         type="nonNegativeDouble" default="0"/>
      <xs:attribute name="space-row"     type="nonNegativeDouble"/>
      <xs:attribute name="space-column"  type="nonNegativeDouble"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <for> — iteration control element                               -->
  <!-- ================================================================ -->
  <xs:element name="for">
    <xs:annotation>
      <xs:documentation>
for — iterates over a list. One child (the template) cloned per item.
Control elements do NOT have box model decorators.

b:of   required — data binding path to QStringList or QVariantList
b:as   required — per-item variable name for template bindings

Example:
  &lt;for b:of="processes" b:as="p"&gt;
      &lt;text b:content="p.name" /&gt;
  &lt;/for&gt;
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="layoutChildren" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attributeGroup ref="bindingAttrs"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================ -->
  <!--  <if> — conditional render control element                       -->
  <!-- ================================================================ -->
  <xs:element name="if">
    <xs:annotation>
      <xs:documentation>
if — conditionally renders its child.
Control elements do NOT have box model decorators.

b:prop   condition path (required) — bare form = existence:
         renders child if the property exists AND is not null
equals   literal comparison value — renders child if the property
         exists, is not null, AND its stringified value equals this
         literal (case-sensitive; int 3 → "3", double 3.0 → "3",
         bool true → "true")
b:equals bound comparison value — same as equals, but the target is
         read from PropertyContext and may change at runtime.
         equals and b:equals are MUTUALLY EXCLUSIVE
         (qCritical, binding ignored). An unresolvable b:equals
         target makes the condition fail.
not      if present (any value), inverts the whole condition.
         not is a structural modifier and cannot be bound (b:not
         is rejected with a warning).

Example:
  &lt;if b:prop="warning"&gt;
      &lt;text b:content="warning" /&gt;
  &lt;/if&gt;
  &lt;if b:prop="status" equals="alarm"&gt;
      &lt;text color="#c0392b"&gt;ALARM&lt;/text&gt;
  &lt;/if&gt;
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:group ref="layoutChildren" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
      <xs:attribute name="not" type="boolType"/>
      <xs:attribute name="equals" type="xs:string"/>
      <xs:attributeGroup ref="bindingAttrs"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
